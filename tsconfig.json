{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "rootDir": ".",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strictPropertyInitialization": false,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "bun"
        ],
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules/**"
    ]
}